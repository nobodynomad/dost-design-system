# =====================================
# PROJECT CONFIGURATION
# =====================================
PROJECT_NAME=wp_project
WP_VERSION=6.8
MDB_VERSION=10.11
PMA_VERSION=5.2
PHP_VERSION=8.2

# =====================================
# WORDPRESS CONFIGURATION
# =====================================
# Core Settings
WP_DEBUG=1                    # Enable debug mode (1=on, 0=off)
WP_DEBUG_DISPLAY=false

# Performance Settings - enable for prod.
WP_CACHE=false
WP_COMPRESS_CSS=false
WP_COMPRESS_SCRIPTS=false
WP_ENFORCE_GZIP=false

# Security
DISALLOW_FILE_EDIT=0          # Disable theme/plugin editor (set to 1 in production)
AUTOMATIC_UPDATER_DISABLED=1  # Disable automatic updates (set to 1 for manual control)

# =====================================
# DATABASE CONFIGURATION
# =====================================
DB_HOST=db
DB_NAME=wordpress
DB_USER=wpuser
DB_PASSWORD=wppass
DB_ROOT_PASSWORD=rootpass

# ================================
# PORTS CONFIGURATION
# ================================
WP_PORTS=8000:80              # WordPress site
PMA_PORTS=8080:80             # phpMyAdmin (dev only)
